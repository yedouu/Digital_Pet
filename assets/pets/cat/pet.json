    "sleep": {
      "file": "sleep.webp",
      "fps": 6,
      "loop": true
    },
    "think": {
      "file": "think.webp",
      "fps": 8,
      "loop": true
    },
    "talk": {
      "file": "talk.webp",
      "fps": 12,
      "loop": true
    },
    "drag": {
      "file": "drag.webp",
      "fps": 10,
      "loop": true
    }
  }
